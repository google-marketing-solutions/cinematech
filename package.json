{
  "name": "cinematech",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .eslintignore",
    "format": "prettier --write src/",
    "deploy:dev": "source .env && npm run build && firebase use $FIREBASE_ALIAS && firebase deploy --only hosting:$DEV_SITE_NAME && ENV_NAME=dev npm run tag-and-push",
    "deploy:prod": "source .env && npm run build && firebase use $FIREBASE_ALIAS && firebase deploy --only hosting:$PROD_SITE_NAME && ENV_NAME=prod npm run tag-and-push",
    "tag-and-push": "git tag deploy-$(date +'%Y-%m-%d-%H-%M-%S')-$ENV_NAME && git push --tags"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google-cloud/vertexai": "^1.10.0",
    "@google/genai": "^1.11.0",
    "@langchain/core": "^0.3.66",
    "@langchain/google-genai": "^0.2.16",
    "@mdi/font": "^7.4.47",
    "dotenv": "^17.2.1",
    "lodash": "^4.17.21",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.12.0",
    "@types/google.accounts": "^0.0.17",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.2.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "typescript": "^5.9.2",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.0.5"
  }
}
